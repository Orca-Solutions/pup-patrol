{
  "configVersion": 1,
  "projectId": "pup-patrol",
  "gateway": {
    "host": "127.0.0.1",
    "port": 7500,
    "path": "/streamotter/socket.io",
    "allowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "connections": {},
  "sources": {
    "field": {
      "kind": "fixture",
      "generation": "pup-patrol-fixture-1",
      "fixtureRef": "field"
    }
  },
